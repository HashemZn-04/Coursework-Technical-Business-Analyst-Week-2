    <bpmn:textAnnotation id="TextAnnotation_1h476pm">
      <bpmn:text>Reduces agent lookup time from ~10min to 1-5 seconds</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1lp2bjq">
      <bpmn:text>Allows safe self-service for the ~40% of cases that do not need agent involvement</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11kkhcc">
      <bpmn:text>Removes the manual entry across scattered systems</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1vn29fz">
      <bpmn:text>Agent context is kept fully when the case is routed back and re-explaining to the customer is no longer needed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1nb3pcs">
      <bpmn:text>Replaces the weekly manual reconciliation with real-time visibility (SN-122, SN-085)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ucksj6" associationDirection="None" sourceRef="Activity_0vqoq0i" targetRef="TextAnnotation_1h476pm" />
    <bpmn:association id="Association_1ksuyvw" associationDirection="None" sourceRef="Activity_00kbb87" targetRef="TextAnnotation_1lp2bjq" />
